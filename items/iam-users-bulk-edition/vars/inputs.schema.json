{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ewcloud/ewc-user-tools/refs/heads/main/items/iam-users-bulk-edit/vars/inputs.schema.json",
  "title": "IAM User Bulk Edition Input Configuration Schema",
  "$comment": "Attributes not part of this schema are ignored during input validation",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "tenancy": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "username": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": ["present", "absent"]
              },
              "email": {
                "type": "string",
                "pattern": "^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-zA-Z]{2,}$"
              },
              "first_name": {
                "type": "string"
              },
              "last_name": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "ewc-jhub-training-[0-9a-z]{6}-attendee|ewc-iam-.*|ewc-app-.*"
                    }
                  },
                  "required": [
                    "name"
                  ]
                },
                "uniqueItems": true
              }
            },
            "required": [
              "email"
            ]
          },
          "uniqueItems": true
        },
        "defaults": {
          "type": "object",
          "properties": {
            "deletion_protection": {
              "type": "boolean"
            },
            "state": {
              "type": "string",
              "enum": ["present", "absent"]
            },
            "enabled": {
              "type": "boolean"
            },
            "email_verified": {
              "type": "boolean"
            },
            "required_actions": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["UPDATE_PASSWORD"]
              },
              "uniqueItems": true
            },
            "roles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "ewc-jhub-training-[0-9a-z]{6}-attendee|ewc-iam-.*|ewc-app.*"
                  }
                },
                "required": [
                  "name"
                ]
              },
              "uniqueItems": true
            },
            "roles_reconciliation_mode": {
              "type": "string",
              "enum": ["merge", "replace"]
            }
          },
          "required": [
            "deletion_protection",
            "state",
            "enabled",
            "email_verified",
            "required_actions",
            "roles",
            "roles_reconciliation_mode"
          ]
        }
      },
      "required": [
        "name",
        "users",
        "defaults"
      ]
    }
  },
  "required": [
    "schema_version",
    "tenancy"
  ]
}